# Banco (Turso) — pegue os dois valores com:
#   turso db show caderneta --url
#   turso db tokens create caderneta
TURSO_DATABASE_URL="libsql://caderneta-SEUUSUARIO.turso.io"
TURSO_AUTH_TOKEN="cole-o-token-aqui"

# Fotos (Vercel Blob) — a Vercel preenche sozinha quando você cria a store no painel.
# Só precisa colar aqui se for rodar localmente com `vercel dev`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
